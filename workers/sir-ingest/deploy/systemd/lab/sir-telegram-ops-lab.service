[Unit]
Description=SIR Telegram — bot operacional (lab — User=rcard)
After=network.target empresarial-next-lab.service
Wants=empresarial-next-lab.service

[Service]
Type=simple
User=rcard
WorkingDirectory=/usr/local/empresarial/workers/sir-ingest/telegram
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/usr/local/empresarial/workers/sir-ingest/.env
ExecStart=/usr/local/empresarial/workers/sir-ingest/telegram/venv/bin/python3 main-ops-bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sir-telegram-ops-lab

[Install]
WantedBy=multi-user.target
