# TX ingest (potência óptica GRB) — copie para .env
# cp .env.example .env
#
# SIR_DB_* deve ser igual ao .env.local da raiz (MySQL claroEmpresarial).
# Rodar na raiz: npm run env:check

# --- MySQL SIR (escrita worker) ---
SIR_DB_HOST=127.0.0.1
SIR_DB_PORT=3306
SIR_DB_USER=monitor
SIR_DB_PASSWORD=troque_me
SIR_DB_NAME=claroEmpresarial
# Opcional: socket Unix (WSL MariaDB sem TCP). Vazio = usa HOST/PORT.
SIR_DB_SOCKET=

# --- GRB (mesmo Basic Auth do telnet) ---
GRB_BASE_URL=http://200.255.253.12/grb/topologia_rede/www
GRB_TELNET_USERNAME=
GRB_TELNET_PASSWORD=

# --- Relatório TX ---
TX_ID_REDE=18
TX_REPORT_PATH=relatorio_potencia_optica_tx.php
TX_REGION_UFS=MA,AM,PA,AP
# Limiares do formulário GRB (hidden POTOPT_TX_V), iguais ao Exportar em CSV.
TX_POTOPT_TX_V=-4;-2;0
# Opcional: arquivo local para teste offline (pula o HTTP).
# TX_CSV_FILE=fixtures/potencia_optica_de_transmissao.csv
