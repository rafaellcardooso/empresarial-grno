# BSOD ingest (PME/BSoD) — copie para .env
# cp .env.example .env
#
# SIR_DB_* deve ser igual ao .env.local da raiz (MySQL claroEmpresarial).
# Credenciais Xpertrak/LDAP/SNMP: só por cidade (BSOD_<OPE>_*). Sem fallback global.

# --- MySQL SIR (escrita worker) ---
SIR_DB_HOST=127.0.0.1
SIR_DB_PORT=3306
SIR_DB_USER=monitor
SIR_DB_PASSWORD=troque_me
SIR_DB_NAME=claroEmpresarial

# --- Worker (comum) ---
BSOD_MODEMS_PARALLEL=12
# SNMP: timeout/retries baixos no lab (CMTS inacessível); subir em prod se precisar
SNMP_TIMEOUT=2
SNMP_RETRIES=0
BSOD_SNMP_PARALLEL=8
# Walk CASA casaCmtsCmCpeCmStatusIndex (lento; default off — MAC via snmpget)
BSOD_CASA_CM_INDEX_WALK=0
# CMTS reg status (docsIfCmtsCmStatus* / IF3) — desempate PathTrak offline
BSOD_CMTS_REG_PARALLEL=2
BSOD_CMTS_REG_SNMP_TIMEOUT=15
BSOD_CMTS_REG_WALK_DEADLINE_SEC=180
# Walk MAC com early-exit quando cmPtr não resolve (≤50 pendentes por CMTS)
BSOD_CMTS_REG_TARGETED_WALK=1
BSOD_CMTS_REG_TARGETED_WALK_MAX=50
# Walk completo docsIfCmtsCmStatusMac (lento em CMTS grandes); default desligado
BSOD_CMTS_REG_ALLOW_FULL_WALK=0
# LDAP lookup paralelo no enrich (inventário PME/BSoD)
BSOD_LDAP_PARALLEL=16
# Ping ICMP opcional (desligado: host do ingest não alcança CPE)
BSOD_PING_ENABLED=0
BSOD_PING_ATTEMPTS=3
BSOD_PING_TIMEOUT_SEC=2
BSOD_PING_PARALLEL=16
# Opcional: mapa profile→produto (padrão: config/profiles.txt, igual botNiveis)
# BSOD_PROFILES_PATH=

# --- Portal CRM BSOD (bsod.nocclaro.com.br) ---
BSOD_NOCCLARO_BASE_URL=https://bsod.nocclaro.com.br
BSOD_NOCCLARO_USER=troque_me
BSOD_NOCCLARO_PASS=troque_me

# --- SLS (enabled=true) ---
BSOD_SLS_XPERTRAK_URL=http://xpertrak.sls.virtua.com.br/pathtrak/api
BSOD_SLS_XPERTRAK_USER=datacenter
BSOD_SLS_XPERTRAK_PASS=troque_me
BSOD_SLS_LDAP_SERVER=187.123.92.124
BSOD_SLS_LDAP_BASE_DN=dc=virtua_sls_docsis
BSOD_SLS_LDAP_BIND_DN=uid=datacenter,dc=virtua
BSOD_SLS_LDAP_BIND_PASSWORD=troque_me
BSOD_SLS_SNMP_COMMUNITY=public

# --- MNS (enabled=true) ---
BSOD_MNS_XPERTRAK_URL=http://200.160.100.6/pathtrak/api
BSOD_MNS_XPERTRAK_USER=datacenter
BSOD_MNS_XPERTRAK_PASS=troque_me
BSOD_MNS_LDAP_SERVER=200.189.88.189,200.189.88.196
BSOD_MNS_LDAP_BASE_DN=dc=virtua_mns_docsis
BSOD_MNS_LDAP_BIND_DN=uid=datacenter,dc=virtua
BSOD_MNS_LDAP_BIND_PASSWORD=troque_me
BSOD_MNS_SNMP_COMMUNITY=

# --- BLM (enabled=true) ---
BSOD_BLM_XPERTRAK_URL=http://187.122.251.98/pathtrak/api
BSOD_BLM_XPERTRAK_USER=datacenter
BSOD_BLM_XPERTRAK_PASS=troque_me
BSOD_BLM_LDAP_SERVER=187.122.254.115,187.122.254.99
BSOD_BLM_LDAP_BASE_DN=dc=virtua_cluster-blm_docsis
BSOD_BLM_LDAP_BIND_DN=uid=datacenter,dc=virtua
BSOD_BLM_LDAP_BIND_PASSWORD=troque_me
BSOD_BLM_SNMP_COMMUNITY=
