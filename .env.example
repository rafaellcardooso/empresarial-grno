# Empresarial (Next.js) — copie para .env.local
# cp .env.example .env.local
#
# Rodar: npm run env:check

# --- MySQL SIR (RAL/REC) — leitura Next + mesmas credenciais no worker ---
# Mesmo usuário/senha MySQL do hfc-sls (HFC_DB_*).
#
# WSL + MariaDB local:
#   npm run db:bootstrap
#   npm run db:migrate && npm run db:import
#
# Produção: banco vazio + ingest (sem db:import)
#   cd /usr/local/empresarial && npm install
#   node scripts/db/bootstrap-sir.mjs | sudo mariadb
#   npm run db:migrate && npm run db:seed-staff
#   Ver deploy/README.md
SIR_DB_HOST=127.0.0.1
SIR_DB_PORT=3306
SIR_DB_USER=monitor
SIR_DB_PASSWORD=troque_me
SIR_DB_NAME=claroEmpresarial
# Opcional: socket Unix (WSL MariaDB sem TCP). Vazio = usa HOST/PORT.
SIR_DB_SOCKET=
#
# Docker (porta 3307):
#   docker compose -f docker-compose.dev.yml up -d && npm run db:setup
# SIR_DB_PORT=3307
# SIR_DB_ROOT_PASSWORD=root_dev

# --- MySQL hfc-sls (tbl_inventory_pme BSOD) — somente leitura ---
HFC_DB_HOST=127.0.0.1
HFC_DB_USER=monitor
HFC_DB_PASSWORD=troque_me
HFC_DB_NAME=hfc-sls

# --- App ---
# Com Nginx path /empresarial (obrigatório em prod atrás do portal):
#   next.config.ts → basePath: "/empresarial"
#   NEXT_PUBLIC_BASE_PATH=/empresarial
#   PORT=4001 · HOSTNAME=<IP eth VPN> (ex. 192.168.95.40)
PORT=4001
HOSTNAME=127.0.0.1
NEXT_PUBLIC_BASE_PATH=/empresarial
APP_PUBLIC_URL=http://127.0.0.1:4001/empresarial

# --- GRB (console telnet topologia de rede) ---
GRB_BASE_URL=http://200.255.253.12/grb/topologia_rede/www
# GRB_TELNET_ARG0=_]C<>:<;@>
GRB_TELNET_USERNAME=
GRB_TELNET_PASSWORD=

# --- Critel (gráficos de desempenho de circuitos) ---
CRITEL_BASE_URL=http://200.255.253.12/grb/critel

# --- Auth (JWT em cookie HTTP-only) ---
AUTH_SECRET=troque_por_string_aleatoria_com_pelo_menos_32_caracteres
# AUTH_COOKIE_SECURE=false   # HTTP sem TLS (ex.: dev interno); omitir se APP_PUBLIC_URL for https://
# Validade do JWT sem "Manter conectado" (cookie some ao fechar o navegador)
AUTH_SESSION_DAYS=7
# Cookie persistente quando "Manter conectado" está marcado
AUTH_SESSION_REMEMBER_DAYS=30
APP_TOUR_VERSION=1

# --- E-mail (opcional — reset de senha) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@grno.local
